{
    "name": "ownerpro/woovi-php-sdk",
    "description": "PHP SDK for the Woovi (OpenPix) API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/OwnerPro-Software/woovi-php-sdk",
    "support": {
        "issues": "https://github.com/OwnerPro-Software/woovi-php-sdk/issues",
        "source": "https://github.com/OwnerPro-Software/woovi-php-sdk"
    },
    "autoload": {
        "psr-4": {
            "OpenPix\\PhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "require": {
        "php": "^7.3 || ^8.0",
        "php-http/discovery": "^1.18",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "*",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "*",
        "psr/http-message": "^1.0 || ^2.0",
        "ext-json": "*"
    },
    "conflict": {
        "open-pix/php-sdk": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --format=txt --verbose",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
